{
  "name": "lime",
  "displayName": "lime",
  "version": "4.2.1",
  "description": "一款集网页摘录、PDF 阅读批注、知识整理与间隔复习于一体的浏览器知识管理插件。",
  "author": "minorcell",
  "scripts": {
    "dev": "plasmo dev",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "build": "plasmo build",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "package": "plasmo package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "marked-react": "^4.0.0",
    "pdfjs-dist": "^6.2.108",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-masonry-css": "^1.0.16"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/chrome": "0.0.258",
    "@types/jest": "^29.5.11",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "fake-indexeddb": "^5.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.2.4",
    "ts-jest": "^29.1.1",
    "typescript": "5.3.3"
  },
  "overrides": {
    "marked": "16.1.1"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "tabs",
      "scripting",
      "storage",
      "notifications",
      "downloads"
    ],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    },
    "action": {
      "default_title": "lime"
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "assets/pdfjs/**"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  }
}
