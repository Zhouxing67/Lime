{
  "name": "lime",
  "displayName": "lime",
  "version": "8.0.0",
  "description": "一款集网页摘录、PDF 阅读批注、知识整理与间隔复习于一体的浏览器知识管理插件。",
  "author": "minorcell",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "dev": "plasmo dev",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "build": "plasmo build",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "postbuild": "node scripts/fix-empty-chunks.mjs",
    "package": "python3 scripts/package.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "alias": {
    "pdfjs-dist": "./assets/pdfjs/pdf.mjs",
    "@/*": "./src/pdf/inklayer/*"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@floating-ui/dom": "^1.8.0",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/themes": "^3.3.0",
    "@types/file-saver": "^2.0.7",
    "dayjs": "^1.11.21",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "i18next": "^26.3.6",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "konva": "^9.0.0",
    "marked-react": "^4.0.0",
    "nanoid": "^5.1.16",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.3.136",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-colorful": "^5.8.0",
    "react-dom": "18.2.0",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "react-masonry-css": "^1.0.16",
    "sass": "^1.102.0",
    "web-highlighter": "^0.7.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/chrome": "0.0.258",
    "@types/jest": "^29.5.11",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^5.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.62.1",
    "prettier": "3.2.4",
    "ts-jest": "^29.1.1",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "marked": "16.1.1"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "tabs",
      "scripting",
      "storage",
      "notifications",
      "downloads"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    },
    "action": {
      "default_title": "lime"
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "assets/pdfjs/**"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  }
}
